{
  "name": "callback",
  "version": "0.1.0",
  "private": true,
  "description": "Callback: the voice agent that makes a small business's money calls, inside the owner's rules, with PayPal doing the money.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs && npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run typecheck",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "sandbox:check": "tsx --env-file-if-exists=.env scripts/sandbox-check.ts",
    "eval:personas": "tsx --env-file-if-exists=.env scripts/eval-personas.ts",
    "eval:adversarial": "tsx --env-file-if-exists=.env scripts/eval-adversarial.ts",
    "cli": "tsx --env-file-if-exists=.env scripts/callback-cli.ts",
    "build:web": "npm --prefix web run build",
    "e2e": "playwright test",
    "eval:ai": "node --env-file-if-exists=.env --import tsx scripts/eval-ai.ts",
    "calibrate": "node --env-file-if-exists=.env --import tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/web-push": "^3.6.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "web-push": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
