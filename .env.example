PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After registering <APP_URL>/webhooks/paypal on the PayPal app (optional: the worker reads PayPal back itself)
PAYPAL_WEBHOOK_ID=
APP_URL=http://localhost:3500
PORT=3500
# Unset = PGlite (Postgres in WebAssembly) in ./data
DATABASE_URL=
SESSION_SECRET=
CB_CURRENCY=USD
# Model (the voice agent's turns, policy compilation, persona eval). Unset = the scripted rules agent, said plainly in the UI.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_READ=gpt-5.5
OPENAI_MODEL_CLASSIFY=gpt-5.4-mini
OPENAI_MODEL_VISION=gpt-5.6-luna
# Realtime voice (browser mic call through OpenAI Realtime, WebRTC). Needs OPENAI_API_KEY. [verify model id against the OpenAI reference]
OPENAI_REALTIME_MODEL=gpt-realtime
# Telephony: outbound phone calls and SMS pay links by Twilio (turn-based: Say + Gather speech). Unset = in-app call simulator.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional voice platform (Vapi / Retell / Bland) webhook secret; events land on /webhooks/voice/events
VOICE_WEBHOOK_SECRET=
# Guard: passkey countersign threshold (cents)
CB_COUNTERSIGN_ABOVE_CENTS=20000
# Channels (all optional; without them messages are simulated on /ops/channels)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Sponsor libraries (optional; pages fall back to plain tables without them)
BRYNTUM_LICENSE_KEY=
AG_GRID_LICENSE_KEY=
AG_STUDIO_URL=
CHANNEL3_API_KEY=
# Demo: persona sign-in, business clock, PayPal fault buttons
CB_DEMO_MODE=true
CB_INLINE_WORKER=true
